# ================================
# DATABASE CONFIGURATION
# ================================
# Para desarrollo local (Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/comebackgolf

# Para producción (separar host, user, pass, etc.)
DATABASE_HOST=db
DATABASE_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=comebackgolf

# ================================
# APPLICATION CONFIGURATION
# ================================
PORT=8000
ENVIRONMENT=development

# ================================
# JWT CONFIGURATION
# ================================
# El algoritmo del JWT es HS256 fijo (no se lee del entorno). Fuera de desarrollo, la
# app no arranca con esta clave de ejemplo ni con una de menos de 32 bytes (ADR-047)
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ================================
# SWAGGER/DOCS PROTECTION
# ================================
# Credenciales para acceder a /docs y /redoc
# Si no están configuradas, la documentación estará bloqueada
DOCS_USERNAME=admin
DOCS_PASSWORD=change-this-password

# ================================
# RBAC CONFIGURATION
# ================================
# Email del administrador del sistema (is_admin = TRUE)
# Este usuario tendrá permisos globales de administración
# Usado en migración 7522c9fc51ef para backfill inicial
ADMIN_EMAIL=admin@example.com

# Buzón de contacto: adonde llegan los mensajes del formulario y a quién se
# dice que escriban los correos (el aviso de cambio de correo, el 429). Sin
# valor, hola@comebackgolf.com, el de los textos legales
CONTACT_EMAIL=hola@comebackgolf.com

# ================================
# MAILGUN CONFIGURATION
# ================================
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=comebackgolf.com
MAILGUN_FROM_EMAIL="Comeback Golf <noreply@comebackgolf.com>"
MAILGUN_API_URL=https://api.eu.mailgun.net/v3

# Envío de correos (BE #563): mailgun (si falta o está vacía; el único en producción) o mailpit
# (buzón local que no entrega: http://localhost:8025). Respaldos si Mailgun da 429/5xx:
# Resend (todos) y, el último, Brevo (nunca correos con token ni avisos de seguridad).
# Este ejemplo trae mailpit para que una copia en local no entregue correos de verdad:
# fuera de ENVIRONMENT=development la app no arranca si no es mailgun
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://localhost:8025
RESEND_API_KEY=
BREVO_API_KEY=

# ================================
# FRONTEND CONFIGURATION
# ================================
# URL del frontend para enlaces en emails (verificación, password reset, etc.)
# Development: http://localhost:5173
# Production: https://www.comebackgolf.com
# Una o varias separadas por comas, la principal la primera (ADR-055): de ellas salen
# los enlaces y la imagen de cabecera de los correos
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos para CORS (separados por coma)
# Development: http://localhost:5173,http://localhost:5174,http://localhost:8080
# Production: https://www.comebackgolf.com
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Dominio para cookies (cross-subdomain authentication)
# CRÍTICO: El punto inicial permite compartir cookies entre subdominios
# Development: Dejar vacío (default a localhost)
# Production: .comebackgolf.com (permite www + api subdominios)
# Ejemplo: .comebackgolf.com permite www.comebackgolf.com y api.comebackgolf.com
# Varios, separados por comas y el de por defecto el primero: cada petición recibe el
# de su Host (ADR-054). Ej.: .comebackgolf.com,.<dominio viejo>
COOKIE_DOMAIN=
